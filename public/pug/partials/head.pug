base(href=baseUrl)
meta(charset='utf-8')
title NyShare
//- ?v busts the 7-day asset cache on every deploy (appVersion changes per build)
link(rel='icon' type='image/png' sizes='32x32' href=`assets/wheel-bow-32x32.png?v=${appVersion}` media='(prefers-color-scheme: light)')
link(rel='icon' type='image/png' sizes='32x32' href=`assets/wheel-wob-32x32.png?v=${appVersion}` media='(prefers-color-scheme: dark)')
link(rel='apple-touch-icon' href=`assets/wheel-bow-180x180.png?v=${appVersion}`)
meta(name='viewport' content='width=device-width, initial-scale=1')
meta(name='robots' content='noindex,nofollow')
link(href=`assets/styles.css?v=${appVersion}` rel='stylesheet')
